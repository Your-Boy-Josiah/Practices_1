### Login as Super Admin
POST {{baseUrl}}/users/LoginUser
Content-Type: application/json

{
  "name": "Josiah SuperAdmin",
  "email": "admin@store.com",
  "password": "AdminPass123!",
  "role": "Super_Admin",
  "phone": "08012345678",
  "age": 24
}

// ============================================================
// 2. PRODUCTS
// ============================================================
### Create a New Product
POST {{baseUrl}}/products/CreateProduct
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Peak Milk Powder 400g",
  "barcode": "100200300",
  "sku": "DAIRY-PEAK-400",
  "category": "Dairy",
  "costPrice": 4200,
  "sellingPrice": 5500,
  "quantity": 50,
  "unit": "tin",
  "reorderLevel": 10,
  "isPerishable": true,
  "description": "Full cream milk powder"
}

### Create a New Product (Without Image)
POST {{baseUrl}}/products/CreateProduct
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Coca Cola 50cl",
  "barcode": "123456789012",
  "category": "Beverages",
  "supplierId": "651f1c305a413028c460d3a1", 
  "costPrice": 150,
  "sellingPrice": 300,
  "quantity": 50
}

### Get All Products
GET {{baseUrl}}/products
Authorization: Bearer {{token}}

### Get a Product by Barcode (POS Scanner)
GET {{baseUrl}}/products/barcode/123456789012
Authorization: Bearer {{token}}

// ============================================================
// 3. SALES / CHECKOUT
// ============================================================ 

### Process a Checkout (Selling the Fanta!)
POST {{baseUrl}}/sales/checkout
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "paymentMethod": "Cash",
  "items": [
    {
      "productId": "6a9aeb85deb665eb87db0287",
      "quantity": 1
    }
  ]
}

### Get Sales History
GET {{baseUrl}}/sales
Authorization: Bearer {{token}}

### Process a Checkout (JSON Payload)
POST {{baseUrl}}/sales/checkout
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "paymentMethod": "Cash",
  "items": [
    {
      "productId": "paste_a_valid_product_id_here",
      "quantity": 2
    }
  ]
}

