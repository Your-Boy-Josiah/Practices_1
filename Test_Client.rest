// 1. AUTHENTICATION (Run this first to get your token)
// ============================================================
### Login as Super Admin
POST {{baseUrl}}/users/LoginUser
Content-Type: application/json

{
  "name": "John SuperAdmin",
  "email": "admin@store.com",
  "password": "AdminPass123!",
  "role": "Super_Admin",
  "phone": "08012345678"
}

// ============================================================
// 2. PRODUCTS
// ============================================================
### Get All Products
GET {{baseUrl}}/products
Authorization: Bearer {{token}}

### Get a Product by Barcode (POS Scanner)
GET {{baseUrl}}/products/barcode/123456789012
Authorization: Bearer {{token}}


// ============================================================
// 3. SALES / CHECKOUT
// ============================================================
### Get Sales History
GET {{baseUrl}}/sales
Authorization: Bearer {{token}}

### Process a Checkout (JSON Payload)
POST {{baseUrl}}/sales/checkout
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "paymentMethod": "Cash",
  "items": [
    {
      "productId": "paste_a_valid_product_id_here",
      "quantity": 2
    }
  ]
}

